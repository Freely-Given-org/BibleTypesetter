\OccursUnder id periph c
\TextType Other
\TextProperties paragraph publishable nonvernacular
\FontSize 10.4
\FirstLineIndent 0
\LeftMargin 0
\RightMargin 0
\Justification Center
\SpaceBefore 0
\SpaceAfter 0

\Marker zlink
\StyleType Character
